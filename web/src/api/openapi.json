{
  "openapi": "3.1.0",
  "info": {
    "title": "Koda API",
    "description": "The koda binary: HTTP API, background loop, web app",
    "license": {
      "name": "GPL-3.0-only",
      "identifier": "GPL-3.0-only"
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "wrong credentials"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "responses": {
          "200": {}
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Creates the first admin account and signs it in. Only works while no users exist.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "409": {
            "description": "already set up"
          }
        }
      }
    },
    "/api/v1/auth/status": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/discover/{list}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "discover",
        "parameters": [
          {
            "name": "list",
            "in": "path",
            "description": "trending | popular | upcoming | now_playing | top_rated",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            }
          },
          "409": {
            "description": "TMDB key missing"
          }
        }
      }
    },
    "/api/v1/catalog/movie/{tmdb_id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "movie",
        "parameters": [
          {
            "name": "tmdb_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogMovie"
                }
              }
            }
          },
          "404": {}
        }
      }
    },
    "/api/v1/catalog/search": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {}
        }
      }
    },
    "/api/v1/requests": {
      "get": {
        "tags": [
          "requests"
        ],
        "operationId": "list_requests",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "pending | approved | declined",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "mine",
            "in": "query",
            "description": "Only my own requests. Users without request management only ever see their own.",
            "required": false,
            "schema": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Request"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "requests"
        ],
        "summary": "Requests a film. Creates the title if it is new; if someone already asked\nfor it, this adds the user to that title instead of failing.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          },
          "403": {},
          "429": {
            "description": "quota reached"
          }
        }
      }
    },
    "/api/v1/requests/{id}/approve": {
      "post": {
        "tags": [
          "requests"
        ],
        "operationId": "approve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/requests/{id}/decline": {
      "post": {
        "tags": [
          "requests"
        ],
        "operationId": "decline",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/catalog": {
      "get": {
        "tags": [
          "settings"
        ],
        "operationId": "get_catalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogSettingsView"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Saves catalog settings. A new key is checked against TMDB before it is stored.",
        "operationId": "put_catalog",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogSettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogSettingsView"
                }
              }
            }
          },
          "400": {
            "description": "key rejected"
          }
        }
      }
    },
    "/api/v1/settings/requests": {
      "get": {
        "tags": [
          "settings"
        ],
        "operationId": "get_requests",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quota"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "operationId": "put_requests",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Quota"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quota"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/titles": {
      "get": {
        "tags": [
          "titles"
        ],
        "operationId": "list_titles",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Title"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/titles/{id}": {
      "get": {
        "tags": [
          "titles"
        ],
        "operationId": "one",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Title"
                }
              }
            }
          },
          "404": {}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthStatus": {
        "type": "object",
        "required": [
          "needs_setup"
        ],
        "properties": {
          "needs_setup": {
            "type": "boolean",
            "description": "True until the first admin account exists."
          }
        }
      },
      "CatalogItem": {
        "type": "object",
        "required": [
          "tmdb_id",
          "title",
          "vote_average"
        ],
        "properties": {
          "backdrop_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "local": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LocalState"
              },
              {
                "type": "null"
              }
            ]
          },
          "overview": {
            "type": [
              "string",
              "null"
            ]
          },
          "poster_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "tmdb_id": {
            "type": "integer",
            "format": "int64"
          },
          "vote_average": {
            "type": "number",
            "format": "double"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "CatalogMovie": {
        "type": "object",
        "required": [
          "tmdb_id",
          "title",
          "genres",
          "directors",
          "cast",
          "vote_average",
          "recommendations"
        ],
        "properties": {
          "backdrop_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "cast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "directors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "imdb_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "local": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LocalState"
              },
              {
                "type": "null"
              }
            ]
          },
          "original_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "overview": {
            "type": [
              "string",
              "null"
            ]
          },
          "poster_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommendations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItem"
            }
          },
          "release_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "tagline": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "tmdb_id": {
            "type": "integer",
            "format": "int64"
          },
          "trailer_youtube_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "vote_average": {
            "type": "number",
            "format": "double"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "CatalogPage": {
        "type": "object",
        "required": [
          "page",
          "total_pages",
          "results"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItem"
            }
          },
          "total_pages": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CatalogSettingsUpdate": {
        "type": "object",
        "required": [
          "language"
        ],
        "properties": {
          "language": {
            "type": "string"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "tmdb_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "New key. Omit to keep the current one."
          }
        }
      },
      "CatalogSettingsView": {
        "type": "object",
        "description": "Catalog settings as the UI sees them. The key itself is never returned.",
        "required": [
          "tmdb_key_set",
          "language"
        ],
        "properties": {
          "language": {
            "type": "string"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "tmdb_key_set": {
            "type": "boolean"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Decision": {
        "type": "object",
        "properties": {
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "LocalState": {
        "type": "object",
        "description": "Where a catalog film stands locally, if it is known at all.",
        "required": [
          "title_id",
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "example": "wanted"
          },
          "title_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "username",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "permissions": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "username": {
            "type": "string"
          }
        }
      },
      "NewRequest": {
        "type": "object",
        "required": [
          "tmdb_id"
        ],
        "properties": {
          "tmdb_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "profile_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Quota": {
        "type": "object",
        "description": "Per-user request limit, stored under the `requests.quota` setting.",
        "required": [
          "days"
        ],
        "properties": {
          "days": {
            "type": "integer",
            "format": "int64"
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Maximum films per period. Missing or zero means unlimited."
          }
        }
      },
      "Request": {
        "type": "object",
        "required": [
          "id",
          "title_id",
          "title",
          "status",
          "title_state",
          "requested_by",
          "created_at"
        ],
        "properties": {
          "backdrop_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "decided_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "poster_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "requested_by": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "pending | approved | declined"
          },
          "title": {
            "type": "string"
          },
          "title_id": {
            "type": "integer",
            "format": "int64"
          },
          "title_state": {
            "type": "string",
            "description": "Lifecycle state of the film itself."
          },
          "tmdb_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "Title": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "state",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "backdrop_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "imdb_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "last_search_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "next_search_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "overview": {
            "type": [
              "string",
              "null"
            ]
          },
          "poster_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "state": {
            "type": "string",
            "description": "requested | wanted | searching | grabbed | downloading | importing | available"
          },
          "state_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Plain-language reason for the current state, when there is one."
          },
          "title": {
            "type": "string"
          },
          "tmdb_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "updated_at": {
            "type": "integer",
            "format": "int64"
          },
